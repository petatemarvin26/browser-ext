{
  "name": "browser-ext",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "npx ts-patch install",
    "clean": "rm -rf ./dist",
    "bundle": "npx webpack --config ./config/webpack/webpack.config.js",
    "build": "npm run clean && npm run bundle",
    "start": "npm-watch"
  },
  "watch": {
    "build": {
      "patterns": [
        "src/**/*.*"
      ],
      "extensions": "ts,html,css,json,png",
      "ignore": [
        "node_modules",
        "dist"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@types/chrome": "^0.0.316",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "dotenv": "^16.5.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-watch": "^0.13.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-patch": "^3.3.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.8.3",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  }
}
